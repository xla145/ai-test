{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "const": "ui-execution/0.1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "properties": {
        "caseId": {
          "type": "string",
          "minLength": 1
        },
        "stepIndexes": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "expectedIds": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "caseId",
        "stepIndexes",
        "expectedIds"
      ],
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "properties": {
        "environment": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "entry": {
          "type": "string",
          "minLength": 1
        },
        "data": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "key": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "ref",
              "key"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "environment",
        "role",
        "entry",
        "data"
      ],
      "additionalProperties": false
    },
    "targets": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "page": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "region",
                    "dialog",
                    "row",
                    "form_item",
                    "listbox"
                  ]
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "key": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "kind",
                "name"
              ],
              "additionalProperties": false
            }
          },
          "control": {
            "type": "string",
            "enum": [
              "textbox",
              "checkbox",
              "combobox",
              "button",
              "option",
              "status"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "placeholder": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "page",
          "scope",
          "control"
        ],
        "additionalProperties": false
      }
    },
    "steps": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "sourceStep": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "expectedIds": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "enum": [
              "fill",
              "check",
              "click"
            ]
          },
          "value": {
            "type": [
              "string",
              "boolean"
            ]
          },
          "assertions": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "target": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "value",
                    "text",
                    "checked"
                  ]
                },
                "expected": {
                  "type": [
                    "string",
                    "boolean"
                  ]
                },
                "evidence": {
                  "type": "string",
                  "const": "dom"
                }
              },
              "required": [
                "target",
                "kind",
                "expected",
                "evidence"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "sourceStep",
          "expectedIds",
          "target",
          "action",
          "assertions"
        ],
        "additionalProperties": false
      }
    },
    "coverage": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "expectedId": {
            "type": "string",
            "minLength": 1
          },
          "stepIds": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "expectedId",
          "stepIds"
        ],
        "additionalProperties": false
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "blocked",
        "ready"
      ]
    }
  },
  "required": [
    "version",
    "id",
    "title",
    "source",
    "execution",
    "targets",
    "steps",
    "coverage",
    "unresolved",
    "status"
  ],
  "additionalProperties": false
}
