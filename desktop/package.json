{
  "name": "@ai-test/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "AIProbe 桌面壳：Electron + React，内嵌浏览器，驱动 Codex App Server",
  "main": "dist/main/index.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run deps && npm run build:main && npm run build:renderer",
    "typecheck": "npm run deps && tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "vitest run",
    "prepare:engine": "cd .. && scripts/prepare-engine-deps.sh",
    "predev": "npm run prepare:engine",
    "dev": "npm run deps && concurrently -k \"vite\" \"node scripts/dev-electron.mjs\"",
    "prestart": "npm run prepare:engine",
    "start": "electron .",
    "deps": "npm run build --prefix ../mcp-servers",
    "dist": "npm run build && electron-builder --publish never",
    "preview:web": "vite"
  },
  "devDependencies": {
    "@ant-design/icons": "^5.6.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "antd": "^5.29.3",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "38.8.6",
    "electron-builder": "^26.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "5.9",
    "vite": "^6.4.6",
    "vitest": "^5.1.0",
    "wait-on": "^9.5.1"
  },
  "type": "module",
  "dependencies": {
    "@ai-test/mcp-servers": "*",
    "electron-updater": "^6.8.11",
    "js-yaml": "^4.1.0"
  },
  "productName": "AIProbe",
  "author": "AIProbe",
  "build": {
    "appId": "dev.aitest.desktop",
    "productName": "AIProbe",
    "artifactName": "AIProbe-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build-resources"
    },
    "files": [
      "dist/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@ai-test/**",
      "node_modules/playwright-core/**",
      "node_modules/@playwright/**",
      "node_modules/playwright/**",
      "node_modules/@midscene/**",
      "node_modules/sharp/**",
      "node_modules/@img/**"
    ],
    "extraResources": [
      {
        "from": "../engine/aitest",
        "to": "engine/aitest",
        "filter": [
          "**/*",
          "!**/__pycache__/**"
        ]
      },
      {
        "from": "../.release/engine-deps",
        "to": "engine-deps"
      },
      {
        "from": "../.release/codex",
        "to": "codex"
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "executableName": "aiprobe"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "publish": {
      "provider": "generic",
      "url": "https://download.classktv.com/aitest-desktop"
    },
    "executableName": "aiprobe"
  }
}
