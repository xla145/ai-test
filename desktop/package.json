{
  "name": "@ai-test/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "AI 测试客户端桌面壳：Electron + React，内嵌浏览器，驱动 Codex App Server",
  "main": "dist/main/index.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run deps && npm run build:main && npm run build:renderer",
    "typecheck": "npm run deps && tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "vitest run",
    "dev": "npm run deps && npm run build:main && concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env AITEST_DEV_SERVER=http://localhost:5173 electron .\"",
    "start": "electron .",
    "deps": "npm run build --prefix ../mcp-servers",
    "dist": "npm run build && electron-builder --publish never",
    "preview:web": "vite"
  },
  "devDependencies": {
    "@ant-design/icons": "^5.6.1",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "antd": "^5.29.3",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "38.8.6",
    "electron-builder": "^26.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "5.9",
    "vite": "^6.4.6",
    "vitest": "^5.1.0",
    "wait-on": "^9.5.1"
  },
  "type": "module",
  "dependencies": {
    "@ai-test/mcp-servers": "*"
  },
  "productName": "AI 测试客户端",
  "author": "ai-test",
  "build": {
    "appId": "dev.aitest.desktop",
    "productName": "AI 测试客户端",
    "artifactName": "aitest-desktop-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build-resources"
    },
    "files": [
      "dist/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@ai-test/**",
      "node_modules/playwright-core/**",
      "node_modules/@playwright/**",
      "node_modules/playwright/**"
    ],
    "extraResources": [
      {
        "from": "../engine/aitest",
        "to": "engine/aitest",
        "filter": [
          "**/*",
          "!**/__pycache__/**"
        ]
      },
      {
        "from": "../.release/engine-deps",
        "to": "engine-deps"
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "executableName": "aitest-desktop"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "identity": null
    },
    "publish": null,
    "executableName": "aitest-desktop"
  }
}
